# Dev: omit VITE_API_BASE_URL to use same-origin `/api` (see vite.config.ts proxy → backend).
# Production: set to your API origin, e.g. https://api.example.com/api
# Cross-site (this host ≠ API host) needs backend AUTH_COOKIE_SAME_SITE=none +
# AUTH_COOKIE_SECURE=true (Partitioned cookies are set automatically). Otherwise
# phones bounce back to /login after a successful sign-in.
# VITE_API_BASE_URL=https://api.example.com/api
# Optional dev proxy target (useful for ngrok/local backend in dev)
# VITE_DEV_PROXY_TARGET=http://localhost:5005

# Optional Socket.IO (defaults to VITE_API_BASE_URL or current origin)
# VITE_SOCKET_URL=http://localhost:5005
# VITE_SOCKET_PATH=/socket.io
# For local dev with Vite proxy, you can leave VITE_SOCKET_URL unset.

# Optional: extra hosts to allow in the Firebase Hosting CSP `connect-src`
# (space or comma separated). Consumed by scripts/generate-firebase-csp.mjs
# — NOT read at runtime by the app. Use for things like an analytics/RUM
# endpoint that VITE_API_BASE_URL / VITE_SOCKET_URL don't already cover.
# VITE_CSP_CONNECT_EXTRA="https://cdn.example.com https://metrics.example.com"

# =============================================================================
# Help Center docs (alonix-docs/) — see alonix-docs/.env.example for full list
# =============================================================================
# Used by `npm run build:firebase` from this repo root (not read from this file).
# PUBLIC_APP_URL=https://app.yourdomain.com

# Docs-only vars (set in alonix-docs/.env or inline when building):
# DOCUSAURUS_BRAND=1glance
# DOCUSAURUS_BASE_URL=/docs/
# DOCUSAURUS_API_MODE=mock
# DOCUSAURUS_API_MOCK_URL=http://localhost:4010
# DOCUSAURUS_API_SANDBOX_URL=http://localhost:5005/api
