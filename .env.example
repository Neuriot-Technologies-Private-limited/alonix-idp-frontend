# Dev: omit VITE_API_BASE_URL to use same-origin `/api` (see vite.config.ts proxy → backend).
# AWS nginx (same origin): leave VITE_API_BASE_URL unset so the SPA calls /api
# on the same host. Backend AUTH_COOKIE_SAME_SITE=lax + AUTH_COOKIE_SECURE=true.
# Cross-site (this host ≠ API host) needs AUTH_COOKIE_SAME_SITE=none +
# AUTH_COOKIE_SECURE=true. Otherwise phones bounce back to /login after sign-in.
# VITE_API_BASE_URL=https://api.example.com/api
# Optional dev proxy target (useful for ngrok/local backend in dev)
# VITE_DEV_PROXY_TARGET=http://localhost:5005

# Optional Socket.IO (defaults to VITE_API_BASE_URL or current origin)
# VITE_SOCKET_URL=http://localhost:5005
# VITE_SOCKET_PATH=/socket.io
# For local dev with Vite proxy, you can leave VITE_SOCKET_URL unset.

# Used by `npm run build:dist` (canonical URL for Help Center).
# PUBLIC_APP_URL=https://app.yourdomain.com

# Docs-only vars (set in alonix-docs/.env or inline when building):
# DOCUSAURUS_BASE_URL=/docs/
# DOCUSAURUS_API_MODE=mock
# DOCUSAURUS_API_MOCK_URL=http://localhost:4010
# DOCUSAURUS_API_SANDBOX_URL=http://localhost:5005/api
