{
  "name": "alonix-idp-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --mode 1glance",
    "dev:1glance": "vite --mode 1glance",
    "dev:with-docs": "bash scripts/build-docs-for-dev.sh && VITE_DOCS_MODE=static vite --mode 1glance",
    "build:docs:dev": "bash scripts/build-docs-for-dev.sh",
    "dev:1glance:enterprise": "VITE_DEPLOYMENT_PROFILE=enterprise vite --mode 1glance",
    "dev:findoutai": "vite --mode findoutai",
    "dev:findoutai:enterprise": "VITE_DEPLOYMENT_PROFILE=enterprise vite --mode findoutai",
    "build": "tsc -b && vite build --mode 1glance",
    "build:1glance": "tsc -b && vite build --mode 1glance",
    "build:1glance:enterprise": "VITE_DEPLOYMENT_PROFILE=enterprise tsc -b && vite build --mode 1glance",
    "build:findoutai": "tsc -b && vite build --mode findoutai",
    "build:findoutai:enterprise": "VITE_DEPLOYMENT_PROFILE=enterprise tsc -b && vite build --mode findoutai",
    "build:firebase": "bash scripts/build-firebase-with-docs.sh",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "qa:deployment": "vitest run src/test/deploymentProfile.test.ts src/test/enterpriseBrandConfig.test.ts"
  },
  "dependencies": {
    "@sentry/react": "^10.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.95.2",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.38.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.7.0",
    "marked": "^17.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.6.6",
    "react-router": "^8.3.0",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^13.31.4",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "socket.io-parser": "4.2.7",
    "nanoid": "3.3.18"
  }
}
