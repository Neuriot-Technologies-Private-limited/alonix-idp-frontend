# FindoutAI — enterprise build overlay (copy values into brand.env or rely on profiles/enterprise.env)
# Build: npm run dev:findoutai:enterprise  |  npm run build:findoutai:enterprise
# API must use DEPLOYMENT_PROFILE=enterprise (see alonix-idp-node-backend/profiles/enterprise.env)

VITE_DEPLOYMENT_PROFILE=enterprise
VITE_BRAND_SHOW_LANDING=false
VITE_BRAND_SHOW_PRICING=false
