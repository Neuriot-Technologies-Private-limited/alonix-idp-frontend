# ─────────────────────────────────────────────────────────────
# Alonix Brand Configuration
# Used by: vite --mode alonix  |  docs: DOCUSAURUS_BRAND=alonix
# DO NOT commit secrets here. This file contains branding only.
# ─────────────────────────────────────────────────────────────

# Identity
VITE_BRAND_NAME="Alonix"
VITE_BRAND_SHORT_NAME="Alonix"
VITE_BRAND_TAGLINE="Intelligent Document Platform — workspaces, AI, and governance"
VITE_BRAND_COPYRIGHT="Alonix Intelligence Systems"

# Colors (light mode)
VITE_BRAND_PRIMARY_LIGHT="#2563eb"
VITE_BRAND_PRIMARY_CONTAINER_LIGHT="#dbeafe"

# Colors (dark mode)
VITE_BRAND_PRIMARY_DARK="#60a5fa"
VITE_BRAND_PRIMARY_CONTAINER_DARK="#1e3a8a"

# Links
VITE_BRAND_SUPPORT_EMAIL="support@alonix.example"
VITE_BRAND_SALES_EMAIL="sales@alonix.example"
VITE_BRAND_WEBSITE_URL="https://alonix.example"
VITE_BRAND_PRIVACY_URL="https://alonix.example/privacy"
VITE_BRAND_TERMS_URL="https://alonix.example/terms"

# Feature flags
VITE_BRAND_SHOW_PRICING="true"
VITE_BRAND_SHOW_LANDING="true"

# Assets Configuration
VITE_BRAND_LOGO_URL="/brand/logo.png"
VITE_BRAND_LOGO_ICON_URL="/brand/logo-icon.png"
VITE_BRAND_FAVICON_URL="/brand/favicon.svg"
