# API playground target mode: mock | sandbox
# mock    → Prism mock server (safe, no real data) — use for public /docs deploy
# sandbox → Alonix IDP backend (non-production only)
DOCUSAURUS_API_MODE=mock

# Mock server (Prism) — started via `npm run mock`
DOCUSAURUS_API_MOCK_URL=http://localhost:4010

# Sandbox backend — local dev or staging URL (never production)
DOCUSAURUS_API_SANDBOX_URL=http://localhost:5005/api

# Site URL (canonical origin). Local dev default:
DOCUSAURUS_SITE_URL=http://localhost:3000

# Base path. Local dev uses `/`. Firebase deploy uses `/docs/` (set in CI).
# DOCUSAURUS_BASE_URL=/docs/

# Optional: staging sandbox
# DOCUSAURUS_API_SANDBOX_URL=https://staging-api.alonix.example/api
