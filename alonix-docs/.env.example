# =============================================================================
# Help Center (Docusaurus) — copy to .env
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Brand (must match frontend vite --mode <brand>)
# -----------------------------------------------------------------------------
# findoutai | 1glance — reads ../brands/<slug>/brand.env + assets
DOCUSAURUS_BRAND=findoutai

# -----------------------------------------------------------------------------
# Site URL & base path (required for production / Firebase builds)
# -----------------------------------------------------------------------------

# Canonical public origin (no trailing slash).
# Local dev: http://localhost:3000
# Production: https://app.yourdomain.com
DOCUSAURUS_SITE_URL=http://localhost:3000

# URL path prefix for the docs site.
# Local dev: leave unset or `/`  →  http://localhost:3000/docs/...
# Firebase (app + /docs): `/docs/`  →  https://app.yourdomain.com/docs/...
# DOCUSAURUS_BASE_URL=/docs/

# -----------------------------------------------------------------------------
# API Playground — mock vs sandbox
# -----------------------------------------------------------------------------

# mock (default) → browser OpenAPI examples — works on deployed docs, no Prism needed
# sandbox      → real backend (local or staging only)
DOCUSAURUS_API_MODE=mock

# Legacy Prism URL (optional local dev only). Default mock uses in-browser examples.
# DOCUSAURUS_API_MOCK_URL=/mock-api

# Real API when DOCUSAURUS_API_MODE=sandbox (or switch server dropdown in playground)
# Local backend:  http://localhost:5005/api
# VM / staging:    https://your-vm-or-staging.example.com/api
# Same origin:     https://app.yourdomain.com/api  (if app proxies /api to backend)
DOCUSAURUS_API_SANDBOX_URL=http://localhost:5005/api

# -----------------------------------------------------------------------------
# Optional — mock server port (default 4010)
# -----------------------------------------------------------------------------
# MOCK_PORT=4010

# -----------------------------------------------------------------------------
# Quick reference
# -----------------------------------------------------------------------------
# Local dev:           cp .env.example .env && npm run start
# Dev + mock API:      npm run dev:mock
# Other brand:         DOCUSAURUS_BRAND=1glance npm run start
# Production build:    DOCUSAURUS_BRAND=findoutai DOCUSAURUS_BASE_URL=/docs/ DOCUSAURUS_SITE_URL=https://app.yourdomain.com npm run build:ci
# From frontend root:  PUBLIC_APP_URL=https://app.yourdomain.com npm run build:firebase
